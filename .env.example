# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_backend
DB_USER=postgres
DB_PASSWORD=postgres
DB_AUTO_MIGRATE=true     # Run golang-migrate up automatically on server start

# ── Embeddings (Ollama by default) ──────────────────────────────────────────
EMBEDDING_PROVIDER=ollama          # "ollama" | "openai"
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu               # "cpu" | "cuda" | "mps"

# ── LLM (local by default, uses Ollama) ──────────────────────────────────────
LLM_PROVIDER=local                 # "local" | "openai" | "anthropic"
LLM_MODEL=llama3.2:3b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_MAX_HISTORY=20
# When running inside Docker Compose, the backend reaches Ollama at http://ollama:11434
# When running the backend directly on your host, use http://localhost:11434
LLM_BASE_URL=http://localhost:11434

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_STRATEGY=sentence            # "fixed" | "sentence" | "paragraph"
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_LENGTH=20