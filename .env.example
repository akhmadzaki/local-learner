# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_backend
DB_USER=postgres
DB_PASSWORD=
DB_AUTO_MIGRATE=true     # Run golang-migrate up automatically on server start

# ── Embeddings (local by default) ────────────────────────────────────────────
EMBEDDING_PROVIDER=local           # "local" | "openai"
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu               # "cpu" | "cuda" | "mps"

# ── LLM (local by default, uses Ollama) ──────────────────────────────────────
LLM_PROVIDER=local                 # "local" | "openai" | "anthropic"
LLM_MODEL=llama-3.2-3b-instruct
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_MAX_HISTORY=20
LLM_BASE_URL=http://localhost:11434  # Ollama API endpoint

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_STRATEGY=sentence            # "fixed" | "sentence" | "paragraph"
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_LENGTH=20